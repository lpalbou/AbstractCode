{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@abstractuic/monitor-flow": ["../../abstractuic/monitor-flow/src/index.ts"],
      "@abstractuic/monitor-flow/*": ["../../abstractuic/monitor-flow/src/*"],
      "@abstractuic/panel-chat": ["../../abstractuic/panel-chat/src/index.ts"],
      "@abstractuic/panel-chat/*": ["../../abstractuic/panel-chat/src/*"],
      "@abstractutils/monitor-gpu": ["../../abstractuic/monitor-gpu/src/index.d.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime.d.ts"]
    },
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["src"]
}
